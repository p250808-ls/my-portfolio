model Model
	culture: zh-TW
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: zh-TW
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation PBI_QueryOrder = ["PG_Server","PG_Database","power_reading","interval_settlement","decision_log","decision_candidates","carbon_budget_daily","esg_waterfall_daily"]

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_ProTooling = ["DevMode"]

ref table power_reading
ref table interval_settlement
ref table decision_log
ref table decision_candidates
ref table carbon_budget_daily
ref table esg_waterfall_daily

ref cultureInfo zh-TW

