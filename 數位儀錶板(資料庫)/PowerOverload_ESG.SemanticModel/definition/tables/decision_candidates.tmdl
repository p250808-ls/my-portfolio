	partition decision_candidates = m
		mode: directQuery
		source =
				let
				    Source = PostgreSQL.Database(PG_Server, PG_Database),
				    Result = Value.NativeQuery(Source, "SELECT candidate_id, decision_id, plan_name,        shed_kw::float8 AS shed_kw, edf_after::float8 AS edf_after, cost_ntd::float8 AS cost_ntd,        delta_carbon_kg::float8 AS delta_carbon_kg, esv_ntd::float8 AS esv_ntd, is_locked, is_chosen FROM public.decision_candidates", null, [EnableFolding = true])
				in
				    Result

	annotation PBI_ResultType = Table

