	partition decision_log = m
		mode: directQuery
		source =
				let
				    Source = PostgreSQL.Database(PG_Server, PG_Database),
				    Result = Value.NativeQuery(Source, "SELECT decision_id, (ts AT TIME ZONE 'Asia/Taipei') AS ts, interval_id,        edf_trigger::float8 AS edf_trigger, tier,        COALESCE(locked_loads::text, '{}') AS locked_loads,        chosen_plan, esv_ntd::float8 AS esv_ntd, shed_kw::float8 AS shed_kw,        delta_carbon_kg::float8 AS delta_carbon_kg, approval_mode, approval_delay_s::int AS approval_delay_s,        ((approval_delay_s::int / 10) * 10)::int AS approval_delay_bin,        outcome_exceeded,        penalty_avoided_ntd::float8 AS penalty_avoided_ntd, oc_production_ntd::float8 AS oc_production_ntd,        carbon_cost_ntd::float8 AS carbon_cost_ntd, r_safety_ntd::float8 AS r_safety_ntd FROM public.decision_log", null, [EnableFolding = true])
				in
				    Result

	annotation PBI_ResultType = Table

