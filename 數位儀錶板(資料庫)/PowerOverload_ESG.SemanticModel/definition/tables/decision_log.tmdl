table decision_log
	lineageTag: 9c86e331-5c14-4804-8e7c-1a7806d149c4

	measure 鎖定觸發次數 = COUNTROWS ( FILTER ( decision_log, LEN ( decision_log[locked_loads] ) > 2 ) ) + 0
		formatString: 0
		displayFolder: 頁面3
		lineageTag: c221b93a-1009-453a-9e4e-c9be0ef7457b

	measure 鎖定違規次數 = 0
		formatString: 0
		displayFolder: 頁面3
		lineageTag: fc0671ad-f192-4f0e-b710-a9ea26040b9a

	measure 人工確認筆數 = CALCULATE ( COUNTROWS ( decision_log ), decision_log[approval_mode] = "manual" )
		formatString: 0
		displayFolder: 頁面2
		lineageTag: 61c469dc-0434-427c-8469-fb4eb0431887

	measure 色_決策列字色 = IF ( SELECTEDVALUE ( decision_log[outcome_exceeded] ) = TRUE (), "#D13438", "#252423" )
		displayFolder: 格式色彩
		lineageTag: 63df90e1-46ac-41b6-b7d6-ca06e9929036

