table power_reading
	lineageTag: d5590781-5596-4e07-980d-a3c12beff399

	measure 最新EDF = MAXX ( TOPN ( 1, ALL ( power_reading ), power_reading[ts], DESC ), power_reading[edf] )
		formatString: 0.0%
		displayFolder: 頁面1
		lineageTag: 45efa619-d79e-4821-817c-b332711ba5cd

	measure 最新剩餘分鐘 = MAXX ( TOPN ( 1, ALL ( power_reading ), power_reading[ts], DESC ), power_reading[remaining_minutes] )
		formatString: 0
		displayFolder: 頁面1
		lineageTag: 7f0c5565-e94f-4664-8106-f9cdf1881217

	measure 最新Buffer_kW = MAXX ( TOPN ( 1, ALL ( power_reading ), power_reading[ts], DESC ), power_reading[buffer_kw] )
		formatString: #,0
		displayFolder: 頁面1
		lineageTag: dfcaae7b-5a0b-4557-bd14-cbde61a71bb1

	measure 最新區間ID = MAXX ( TOPN ( 1, ALL ( power_reading ), power_reading[ts], DESC ), power_reading[interval_id] )
		formatString: 0
		displayFolder: 頁面1
		lineageTag: 802381c9-e6a4-4a9e-8dbd-4772671bb938

	measure 最新鎖定狀態 = VAR s = MAXX ( TOPN ( 1, ALL ( power_reading ), power_reading[ts], DESC ), power_reading[locked_status_text] ) RETURN IF ( s = "", "無鎖定", s )
		displayFolder: 頁面1
		lineageTag: 807184bd-7819-40f1-94fb-742faf8ab40e

	measure 最新WBGT = MAXX ( TOPN ( 1, ALL ( power_reading ), power_reading[ts], DESC ), power_reading[wbgt] )
		formatString: #,0.0
		displayFolder: 頁面1
		lineageTag: af2419bb-3e1f-4643-a193-53f4a5f4d164

	measure 最新製程溫度 = MAXX ( TOPN ( 1, ALL ( power_reading ), power_reading[ts], DESC ), power_reading[process_temp] )
		formatString: #,0.0
		displayFolder: 頁面1
		lineageTag: fe10c8be-cbb7-407f-8439-aee0503b2544

	measure 當前區間累積需量 = VAR _latestInterval = MAXX ( TOPN ( 1, ALL ( power_reading ), power_reading[ts], DESC ), power_reading[interval_id] ) RETURN CALCULATE ( AVERAGE ( power_reading[avg_kw_so_far] ), KEEPFILTERS ( power_reading[interval_id] = _latestInterval ) )
		formatString: #,0
		displayFolder: 頁面1
		lineageTag: 4da4bbad-d876-46f7-b790-b7129a1e6148

	measure 近2小時EDF = VAR t = MAXX ( ALL ( power_reading ), power_reading[ts] ) RETURN CALCULATE ( AVERAGE ( power_reading[edf] ), KEEPFILTERS ( power_reading[ts] > t - 2 / 24 ) )
		formatString: 0.0%
		displayFolder: 頁面1
		lineageTag: 68af9c12-5717-472e-aaf5-644dd1243918

	measure 綠電匹配率 = CALCULATE ( AVERAGE ( power_reading[renewable_pct] ), power_reading[edf] >= 0.5 )
		formatString: 0.00
		displayFolder: 頁面3
		lineageTag: 657b37da-da32-422b-9ecd-6150aad6c0aa

	measure 色_EDF燈號 = VAR e = [最新EDF] RETURN SWITCH ( TRUE (), e >= 0.8, "#D13438", e >= 0.5, "#F7630C", e >= 0.2, "#FFB900", "#107C10" )
		displayFolder: 格式色彩
		lineageTag: 76e7762f-888b-4049-84a0-378ccf5fe146

	measure 色_Buffer字色 = IF ( [最新Buffer_kW] < 0, "#D13438", "#252423" )
		displayFolder: 格式色彩
		lineageTag: 298d070d-0e69-4a5a-a464-3e8c4760e463

	measure 色_WBGT底色 = IF ( [最新WBGT] >= 28, "#F4B6B6", "#FFFFFF" )
		displayFolder: 格式色彩
		lineageTag: 6bda9d6a-0d29-4a85-a31c-18725b031721

	measure 色_製程溫度底色 = IF ( [最新製程溫度] < 82, "#F4B6B6", "#FFFFFF" )
		displayFolder: 格式色彩
		lineageTag: c73d5337-2621-40d0-9afb-a5bf30d30e1f

