	partition power_reading = m
		mode: directQuery
		source =
				let
				    Source = PostgreSQL.Database(PG_Server, PG_Database),
				    Result = Value.NativeQuery(Source, "SELECT (ts AT TIME ZONE 'Asia/Taipei') AS ts,        (ts AT TIME ZONE 'Asia/Taipei')::date AS date_local,        EXTRACT(HOUR FROM (ts AT TIME ZONE 'Asia/Taipei'))::int AS hour_local,        interval_id, minute_in_interval, remaining_minutes,        load_kw::float8 AS load_kw, avg_kw_so_far::float8 AS avg_kw_so_far, buffer_kw::float8 AS buffer_kw,        edf::float8 AS edf, grid_ef::float8 AS grid_ef, renewable_pct::float8 AS renewable_pct,        wbgt::float8 AS wbgt, process_temp::float8 AS process_temp,        COALESCE(locked_status_text, '') AS locked_status_text FROM public.power_reading", null, [EnableFolding = true])
				in
				    Result

	annotation PBI_ResultType = Table

