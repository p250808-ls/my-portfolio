{
  "name": "KMV ESG",
  "dataColors": [
    "#2a78d6",
    "#eb6834",
    "#1baf7a",
    "#eda100",
    "#e87ba4",
    "#008300",
    "#6250d6",
    "#e34948"
  ],
  "background": "#fcfcfb",
  "foreground": "#0b0b0b",
  "tableAccent": "#2a78d6",
  "good": "#0ca30c",
  "neutral": "#fab219",
  "bad": "#d03b3b",
  "minimum": "#cde2fb",
  "center": "#6da7ec",
  "maximum": "#184f95",
  "textClasses": {
    "title": {
      "color": "#0b0b0b",
      "fontSize": 12
    },
    "header": {
      "color": "#0b0b0b",
      "fontSize": 12
    },
    "label": {
      "color": "#52514e",
      "fontSize": 10
    },
    "callout": {
      "color": "#0b0b0b",
      "fontSize": 28
    }
  },
  "visualStyles": {
    "*": {
      "*": {
        "title": [
          {
            "show": true,
            "fontColor": {
              "solid": {
                "color": "#0b0b0b"
              }
            },
            "fontSize": 12,
            "bold": true
          }
        ],
        "background": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#ffffff"
              }
            }
          }
        ],
        "border": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#e4e3df"
              }
            },
            "radius": 6
          }
        ],
        "valueAxis": [
          {
            "gridlineColor": {
              "solid": {
                "color": "#e4e3df"
              }
            },
            "labelColor": {
              "solid": {
                "color": "#52514e"
              }
            }
          }
        ],
        "categoryAxis": [
          {
            "labelColor": {
              "solid": {
                "color": "#52514e"
              }
            }
          }
        ],
        "legend": [
          {
            "labelColor": {
              "solid": {
                "color": "#52514e"
              }
            }
          }
        ]
      }
    },
    "page": {
      "*": {
        "background": [
          {
            "color": {
              "solid": {
                "color": "#f4f3f0"
              }
            },
            "transparency": 0
          }
        ]
      }
    },
    "waterfallChart": {
      "*": {
        "sentimentColors": [
          {
            "increaseFill": {
              "solid": {
                "color": "#2a78d6"
              }
            },
            "decreaseFill": {
              "solid": {
                "color": "#e34948"
              }
            },
            "totalFill": {
              "solid": {
                "color": "#52514e"
              }
            }
          }
        ]
      }
    },
    "card": {
      "*": {
        "labels": [
          {
            "color": {
              "solid": {
                "color": "#0b0b0b"
              }
            }
          }
        ],
        "categoryLabels": [
          {
            "color": {
              "solid": {
                "color": "#52514e"
              }
            }
          }
        ]
      }
    }
  }
}