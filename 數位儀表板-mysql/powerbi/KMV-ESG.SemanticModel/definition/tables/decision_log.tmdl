table decision_log
	lineageTag: 01eeaccd-b540-5c43-88bf-441d777785bf

	measure '決策次數' = COUNTROWS ( decision_log )
		formatString: 0
		lineageTag: 91fbc34b-fb36-5252-9b21-276cc95f609a

	measure '人工決策次數' = CALCULATE ( COUNTROWS ( decision_log ), decision_log[approval_mode] = "manual" )
		formatString: 0
		lineageTag: 7e4a279b-71f8-55ae-a8b4-fc7080386288

	measure '鎖定觸發次數' = CALCULATE ( COUNTROWS ( decision_log ), LEN ( decision_log[locked_loads] ) > 2 )
		formatString: 0
		lineageTag: 78f74617-a46a-507e-a8ab-ed595a1536aa

	column decision_id
