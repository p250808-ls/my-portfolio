	partition decision_log = m
		mode: import
		source =
				let
				    Source = MySQL.Database("tokaido.proxy.rlwy.net:18473", "kmv_esg", [ReturnSingleDatabase = true]),
				    Data = Source{[Schema = "kmv_esg", Item = "decision_log"]}[Data],
				    Kept = Table.SelectColumns(Data, {"decision_id", "ts", "interval_id", "edf_trigger", "tier", "locked_loads", "chosen_plan", "esv_ntd", "shed_kw", "delta_carbon_kg", "approval_mode", "approval_delay_s", "outcome_exceeded", "penalty_avoided_ntd", "oc_production_ntd", "carbon_cost_ntd", "r_safety_ntd"}),
				    Json = Table.TransformColumns(Kept, {{"locked_loads", each if _ is binary then Text.FromBinary(_) else _, type text}}),
				    Typed = Table.TransformColumnTypes(Json, {{"decision_id", Int64.Type}, {"ts", type datetime}, {"interval_id", Int64.Type}, {"edf_trigger", type number}, {"tier", type text}, {"chosen_plan", type text}, {"esv_ntd", type number}, {"shed_kw", type number}, {"delta_carbon_kg", type number}, {"approval_mode", type text}, {"approval_delay_s", Int64.Type}, {"outcome_exceeded", type logical}, {"penalty_avoided_ntd", type number}, {"oc_production_ntd", type number}, {"carbon_cost_ntd", type number}, {"r_safety_ntd", type number}}),
				    Add0 = Table.AddColumn(Typed, "decision_label", each DateTime.ToText([ts], "MM/dd HH:mm") & "｜" & [tier] & "｜EDF " & Number.ToText([edf_trigger], "P0"), type text)
				in
				    Add0
