	partition decision_candidates = m
		mode: import
		source =
				let
				    Source = MySQL.Database("tokaido.proxy.rlwy.net:18473", "kmv_esg", [ReturnSingleDatabase = true]),
				    Data = Source{[Schema = "kmv_esg", Item = "decision_candidates"]}[Data],
				    Kept = Table.SelectColumns(Data, {"candidate_id", "decision_id", "plan_name", "shed_kw", "edf_after", "penalty_avoided_ntd", "cost_ntd", "delta_carbon_kg", "esv_ntd", "is_locked", "is_chosen"}),
				    Typed = Table.TransformColumnTypes(Kept, {{"candidate_id", Int64.Type}, {"decision_id", Int64.Type}, {"plan_name", type text}, {"shed_kw", type number}, {"edf_after", type number}, {"penalty_avoided_ntd", type number}, {"cost_ntd", type number}, {"delta_carbon_kg", type number}, {"esv_ntd", type number}, {"is_locked", type logical}, {"is_chosen", type logical}}),
				    Add0 = Table.AddColumn(Typed, "plan_status", each if [is_chosen] then "選定方案" else if [is_locked] then "安全鎖定（不可選）" else "未選方案", type text)
				in
				    Add0
