		lineageTag: c25a14b0-03ae-5b26-98fd-230fcaecb202
		summarizeBy: sum
		sourceColumn: sigma_kw

	column sigma_avg_kw
		dataType: double
		formatString: #,0.##
		lineageTag: 19b0490f-b343-5080-a28e-eecc88c6dcc7
		summarizeBy: sum
		sourceColumn: sigma_avg_kw

	column edf
		dataType: double
		formatString: 0.0%
		lineageTag: 01d8ee85-1119-55df-8a8a-b0ca59e23e19
		summarizeBy: sum
		sourceColumn: edf

	column grid_ef
		dataType: double
		formatString: #,0.##
		lineageTag: ad8bdb2e-a824-52d3-9c87-b6a8150d5c21
		summarizeBy: sum
		sourceColumn: grid_ef

	column renewable_pct
		dataType: double
		formatString: #,0.##
		lineageTag: e04585e6-d0c8-5376-abf7-3e487f0405f9
		summarizeBy: sum
		sourceColumn: renewable_pct

