	partition power_reading = m
		mode: import
		source =
				let
				    Source = MySQL.Database("tokaido.proxy.rlwy.net:18473", "kmv_esg", [ReturnSingleDatabase = true]),
				    Data = Source{[Schema = "kmv_esg", Item = "power_reading"]}[Data],
				    Kept = Table.SelectColumns(Data, {"ts", "interval_id", "minute_in_interval", "remaining_minutes", "load_kw", "avg_kw_so_far", "contract_kw", "buffer_kw", "sigma_kw", "sigma_avg_kw", "edf", "grid_ef", "renewable_pct", "wbgt", "process_temp", "locked_status_text"}),
				    Typed = Table.TransformColumnTypes(Kept, {{"ts", type datetime}, {"interval_id", Int64.Type}, {"minute_in_interval", Int64.Type}, {"remaining_minutes", Int64.Type}, {"load_kw", type number}, {"avg_kw_so_far", type number}, {"contract_kw", type number}, {"buffer_kw", type number}, {"sigma_kw", type number}, {"sigma_avg_kw", type number}, {"edf", type number}, {"grid_ef", type number}, {"renewable_pct", type number}, {"wbgt", type number}, {"process_temp", type number}, {"locked_status_text", type text}}),
				    Add0 = Table.AddColumn(Typed, "date", each DateTime.Date([ts]), type date),
				    Add1 = Table.AddColumn(Add0, "hour", each Time.Hour([ts]), Int64.Type)
				in
				    Add1
