table power_reading
	lineageTag: 3def249e-a8c5-53ed-af7c-c23180f3cf68

	measure '最新EDF' =
			VAR t = CALCULATE ( MAX ( power_reading[ts] ), ALL ( power_reading ) )
			RETURN CALCULATE ( MAX ( power_reading[edf] ), ALL ( power_reading ), power_reading[ts] = t )
		formatString: 0.0%
		lineageTag: 74710ca5-2805-5c24-9020-98406ef1c5ac

	measure '最新剩餘分鐘' =
			VAR t = CALCULATE ( MAX ( power_reading[ts] ), ALL ( power_reading ) )
			RETURN CALCULATE ( MAX ( power_reading[remaining_minutes] ), ALL ( power_reading ), power_reading[ts] = t )
		formatString: 0
		lineageTag: e4a8343a-773e-533a-a0fa-64e21b2ac986

	measure '最新Buffer_kW' =
			VAR t = CALCULATE ( MAX ( power_reading[ts] ), ALL ( power_reading ) )
			RETURN CALCULATE ( MAX ( power_reading[buffer_kw] ), ALL ( power_reading ), power_reading[ts] = t )
		formatString: #,0
		lineageTag: 0dfd1da5-59b5-52b6-80e8-8f7f9df31465

	measure '最新區間ID' =
			VAR t = CALCULATE ( MAX ( power_reading[ts] ), ALL ( power_reading ) )
			RETURN CALCULATE ( MAX ( power_reading[interval_id] ), ALL ( power_reading ), power_reading[ts] = t )
		formatString: 0
		lineageTag: d7d82e59-ac8e-5cc0-b37b-0a1e827f65a4

	measure '最新WBGT' =
			VAR t = CALCULATE ( MAX ( power_reading[ts] ), ALL ( power_reading ) )
			RETURN CALCULATE ( MAX ( power_reading[wbgt] ), ALL ( power_reading ), power_reading[ts] = t )
		formatString: 0.0
		lineageTag: 30a11c39-1a53-5fc3-92ab-d8a86e494fcf

	measure '最新製程溫度' =
			VAR t = CALCULATE ( MAX ( power_reading[ts] ), ALL ( power_reading ) )
			RETURN CALCULATE ( MAX ( power_reading[process_temp] ), ALL ( power_reading ), power_reading[ts] = t )
		formatString: 0.0
		lineageTag: fc0fa3ee-bd73-5df2-9fb2-ca8762d42906

	measure '最新鎖定狀態' =
			VAR t = CALCULATE ( MAX ( power_reading[ts] ), ALL ( power_reading ) )
			VAR s = LOOKUPVALUE ( power_reading[locked_status_text], power_reading[ts], t )
			RETURN IF ( s = "", "無鎖定", s )
		lineageTag: 41b17e8a-3187-5c78-aba8-bb9f5b2327d3

	measure '最新區間平均需量' =
			VAR latestInterval = [最新區間ID]
			RETURN CALCULATE ( AVERAGE ( power_reading[avg_kw_so_far] ), power_reading[interval_id] = latestInterval )
		formatString: #,0
		lineageTag: 7674fd4a-b0c7-5388-bd73-ed3215f840c6

	measure '契約容量' = MAX ( power_reading[contract_kw] )
		formatString: #,0
		lineageTag: cbbfd9ac-cbe6-5b58-8247-93836400f1f4

	measure '近2小時EDF' =
			VAR t = CALCULATE ( MAX ( power_reading[ts] ), ALL ( power_reading ) )
			RETURN IF ( MAX ( power_reading[ts] ) >= t - 2 / 24, AVERAGE ( power_reading[edf] ) )
		formatString: 0.0%
		lineageTag: a67ef59e-1e52-59eb-b2fc-6ce64c16318f

	measure '綠電匹配率' = CALCULATE ( AVERAGE ( power_reading[renewable_pct] ), power_reading[edf] >= 0.5 ) / 100
		formatString: 0.0%
		lineageTag: 1e55b25c-f46a-57dc-bbb3-7e9aafb9e0d9

	column ts
		dataType: dateTime
		formatString: yyyy-mm-dd hh:nn
